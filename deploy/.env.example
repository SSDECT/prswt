# ~/prswt/deploy/.env on the server (chmod 600). Never commit real values.
POSTGRES_PASSWORD=<generated on the server>
PRSWT_PUBLIC_URL=https://prswt.juz.ai
PRSWT_ALLOWED_EMAILS=you@juz.ai
# Whole email domains allowed to sign in (comma-separated, or * for any).
# People invited to a project may sign in regardless. Each person sees only
# the projects they are a member of.
PRSWT_ALLOWED_DOMAINS=juz.ai
# Optional second provider (off on prswt.juz.ai): GOOGLE_CLIENT_ID= and GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Your directory's tenant id (one organization). For several organizations
# use MICROSOFT_TENANT=organizations and list their tenant ids in
# MICROSOFT_ALLOWED_TENANTS; then only emails the directory verified count.
MICROSOFT_TENANT=
MICROSOFT_ALLOWED_TENANTS=
PRSWT_SESSION_HOURS=168
